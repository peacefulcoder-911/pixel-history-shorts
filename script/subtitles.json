[
  {"start": 0.0, "end": 1.4, "text": "IN 1962,", "highlight": "1962"},
  {"start": 1.4, "end": 2.8, "text": "THREE MEN PULLED OFF", "highlight": "PULLED"},
  {"start": 2.8, "end": 3.8, "text": "THE IMPOSSIBLE:", "highlight": "IMPOSSIBLE"},
  {"start": 3.8, "end": 5.4, "text": "ESCAPING FROM ALCATRAZ,", "highlight": "ALCATRAZ"},
  {"start": 5.4, "end": 7.0, "text": "THE MOST INESCAPABLE", "highlight": "INESCAPABLE"},
