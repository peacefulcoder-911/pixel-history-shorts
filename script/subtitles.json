  {"start": 8.7, "end": 9.7, "text": "FRANK MORRIS", "highlight": "MORRIS"},
  {"start": 9.7, "end": 10.9, "text": "AND THE ANGLIN BROTHERS", "highlight": "ANGLIN"},
