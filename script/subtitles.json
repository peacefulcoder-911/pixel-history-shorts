  {"start": 21.4, "end": 23.0, "text": "TUCKING THEM IN BED.", "highlight": "BED"},
  {"start": 23.0, "end": 24.1, "text": "IN THE DEAD OF NIGHT,", "highlight": "DEAD"},
  {"start": 24.1, "end": 24.8, "text": "THEY SLIPPED INTO", "highlight": "SLIPPED"},
  {"start": 24.8, "end": 25.8, "text": "THE UTILITY PIPES,", "highlight": "PIPES"},
  {"start": 25.8, "end": 27.2, "text": "CLIMBED TO THE ROOF,", "highlight": "ROOF"},
  {"start": 27.2, "end": 28.7, "text": "AND INFLATED A RAFT", "highlight": "RAFT"},
  {"start": 28.7, "end": 29.8, "text": "MADE FROM 50", "highlight": "50"},
