  {"start": 31.1, "end": 32.1, "text": "THEY LAUNCHED INTO", "highlight": "LAUNCHED"},
  {"start": 32.1, "end": 33.7, "text": "FREEZING OCEAN WATERS", "highlight": "FREEZING"},
  {"start": 33.7, "end": 34.8, "text": "OF SAN FRANCISCO BAY...", "highlight": "BAY"},
  {"start": 34.8, "end": 36.7, "text": "AND VANISHED FOREVER!", "highlight": "VANISHED"},
  {"start": 36.7, "end": 38.1, "text": "DID THEY SURVIVE?", "highlight": "SURVIVE"},
  {"start": 38.1, "end": 39.2, "text": "TO THIS DAY,", "highlight": "DAY"},
  {"start": 39.2, "end": 40.8, "text": "THE CASE REMAINS UNSOLVED.", "highlight": "UNSOLVED"}
