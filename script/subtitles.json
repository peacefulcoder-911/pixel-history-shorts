  {"start": 16.1, "end": 17.5, "text": "TO FOOL THE GUARDS,", "highlight": "GUARDS"},
  {"start": 17.5, "end": 19.0, "text": "THEY SCULPTED FAKE HEADS", "highlight": "FAKE"},
  {"start": 19.0, "end": 20.3, "text": "FROM SOAP & PAPER,", "highlight": "SOAP"},
